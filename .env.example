# ============================================================
# Environment variables template. Copy to ".env" and
# fill in with real values (strong passwords, never these).
#
#   cp .env.example .env
#
# Generate a strong password in the terminal:
#   openssl rand -base64 24
# ============================================================

# To run API locally or on codespaces
# cp .env server/.env

# --- MySQL ---
MYSQL_DATABASE=clinica_db
MYSQL_USER=clinica_user
MYSQL_PASSWORD=change_to_a_strong_password
MYSQL_ROOT_PASSWORD=change_to_a_strong_password

# --- Server URL ---
VITE_API_URL=http://localhost:8080